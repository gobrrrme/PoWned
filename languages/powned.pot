msgstr ""

#. Description of the plugin
#: powned.php
msgid "Protects expensive pages (by default WooCommerce filter URLs) with a small Bitcoin-style proof of work solved in the visitor's browser. Stops crawlers that hammer thousands of URL combinations from rotating IPs, without third-party services, tracking or CAPTCHAs. Difficulty adjusts to server load."
msgstr ""

#. Author of the plugin
#: powned.php
msgid "GoBrrr"
msgstr ""

#. Author URI of the plugin
#: powned.php
msgid "https://www.gobrrr.me"
msgstr ""

